<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main background color of the card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#12131C" />
            <stroke android:width="1.5dp" android:color="#3300FFFF" />
        </shape>
    </item>
    <!-- Cyan glow top-left -->
    <item android:top="-50dp" android:left="-50dp" android:right="120dp" android:bottom="120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:startColor="#4000FFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Purple glow bottom-right -->
    <item android:top="100dp" android:left="100dp" android:right="-60dp" android:bottom="-60dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#40AA00FF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
