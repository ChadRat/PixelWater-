<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Pixel Water"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name="com.pixelwater.app.MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:keepScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.pixelwater.app.WaterReminderListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/show-water-reminder" />
            </intent-filter>
        </service>

        <!-- Wear OS Complications -->
        <service
            android:name="com.pixelwater.app.complication.QuickAddComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_water_drop"
            android:label="Quick Add Water"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,RANGED_VALUE,MONOCHROMATIC_IMAGE,SMALL_IMAGE,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <service
            android:name="com.pixelwater.app.complication.WaterProgressComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_water_drop"
            android:label="Water Intake Progress"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <receiver
            android:name="com.pixelwater.app.complication.QuickAddComplicationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pixelwater.app.ACTION_QUICK_ADD_WATER" />
            </intent-filter>
        </receiver>

        <!-- Wear OS Tiles -->
        <service
            android:name="com.pixelwater.app.tile.WaterProgressTileService"
            android:exported="true"
            android:icon="@drawable/ic_water_drop"
            android:label="Pixel Water Progress Tile"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_water_drop" />
        </service>

        <service
            android:name="com.pixelwater.app.tile.WaterGraphTileService"
            android:exported="true"
            android:icon="@drawable/ic_water_drop"
            android:label="Pixel Water Graph Tile"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_water_drop" />
        </service>
    </application>

</manifest>
